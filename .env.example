# Copy to .env for local development. Never put real secrets in this file.
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
TRUST_PROXY=1
MAX_JSON_BODY=256kb
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
MAX_PAYMENT_AMOUNT=500000
FORCE_HTTPS_REDIRECT=false
INCLUDE_DEBUG_RAW=false

# CDEK credentials and sender details
CDEK_API_KEY=your-cdek-api-key
CDEK_API_PASSWORD=your-cdek-api-password
CDEK_SENDER_CITY_CODE=438
CDEK_SENDER_PVZ_CODE=
CDEK_SENDER_ADDRESS=
CDEK_DEFAULT_TARIFF_CODE=136
CDEK_SENDER_COMPANY=Serafim
CDEK_SENDER_NAME=
CDEK_SENDER_EMAIL=
CDEK_SENDER_PHONE=

# YooKassa credentials — use test-mode credentials for development
YOOKASSA_SHOP_ID=your-yookassa-shop-id
YOOKASSA_SECRET_KEY=your-yookassa-secret-key
YOOKASSA_API_URL=https://api.yookassa.ru/v3
YOOKASSA_WEBHOOK_IP_ALLOWLIST=
YOOKASSA_WEBHOOK_SECRET=

# Frontend origins and payment return hosts; replace with your deployed domain
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
ALLOWED_RETURN_HOSTS=localhost,127.0.0.1

# Admin credentials. Prefer ADMIN_PASSWORD_HASH; it takes precedence over ADMIN_PASSWORD.
# Generate a SHA-256 hash with: npm --prefix backend run hash:admin -- "your-strong-password"
ADMIN_LOGIN=serafim
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
ADMIN_TOKEN_TTL_MS=43200000
ADMIN_LOGIN_WINDOW_MS=900000
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_BLOCK_MS=1800000

# JSON persistence paths (orders.json contains customer data; keep it out of Git)
PRODUCTS_FILE_PATH=backend/data/products.json
ORDERS_FILE_PATH=backend/data/orders.json
